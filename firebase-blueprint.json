{
  "entities": {
    "UserProgress": {
      "title": "UserProgress",
      "description": "Stores a player's non-PII puzzle progress, unlocked levels (1-1000) across 9 games, scores, and audio/language settings.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the player.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Player's chosen nickname or first name.",
          "minLength": 1,
          "maxLength": 80
        },
        "language": {
          "type": "string",
          "description": "Active interface language code.",
          "enum": ["kk", "ru", "en"],
          "maxLength": 4
        },
        "musicEnabled": {
          "type": "boolean",
          "description": "Background music toggle state."
        },
        "sfxEnabled": {
          "type": "boolean",
          "description": "Sound effects toggle state."
        },
        "totalScore": {
          "type": "integer",
          "description": "Cumulative score across all 9 puzzle games."
        },
        "levels": {
          "type": "object",
          "description": "Highest reached level (1 to 1001) for each of the 9 puzzle games."
        },
        "scores": {
          "type": "object",
          "description": "Best/accumulated score per game across the 9 puzzle games."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "language",
        "musicEnabled",
        "sfxEnabled",
        "totalScore",
        "levels",
        "scores",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProgress"
      },
      "description": "Owner-isolated player progress and preferences document."
    }
  }
}
